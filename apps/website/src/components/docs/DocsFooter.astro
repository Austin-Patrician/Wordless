---
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import CommercialFooter from './CommercialFooter.astro';

const { locale, id } = (Astro.locals as { starlightRoute: StarlightRouteData }).starlightRoute;
const english = locale === 'en';
const isBusinessPage = id.endsWith('/docs/business');
const privacyHref = english ? '/privacy/' : '/zh/privacy/';
const termsHref = english ? '/terms/' : '/zh/terms/';
---

<footer class="wordless-doc-footer sl-flex">
  {!isBusinessPage && <CommercialFooter english={english} />}
  <div class="meta sl-flex">
    <LastUpdated />
  </div>
  <nav class="legal-links" aria-label={english ? 'Legal links' : '法律链接'}>
    <a href={privacyHref}>{english ? 'Privacy policy' : '隐私政策'}</a>
    <a href={termsHref}>{english ? 'Terms of service' : '服务条款'}</a>
    <a href="https://github.com/Austin-Patrician/Wordless" target="_blank" rel="noreferrer">GitHub</a>
  </nav>
  <Pagination />
</footer>

<style>
  @layer starlight.core {
    .wordless-doc-footer {
      flex-direction: column;
      gap: 1.5rem;
    }

    .meta {
      gap: .75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 3rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }

    .meta > :global(p:only-child) { margin-inline-start: auto; }

    .legal-links {
      display: flex;
      flex-wrap: wrap;
      gap: .75rem 1.25rem;
      align-items: center;
      margin-top: .25rem;
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-xs);
    }

    .legal-links a { color: inherit; text-decoration: none; }
    .legal-links a:hover { color: var(--sl-color-accent-high); }

  }
</style>
