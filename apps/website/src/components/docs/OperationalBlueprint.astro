---
import {
  CalendarClock,
  CircleCheck,
  Clock3,
  FilePenLine,
  GitBranch,
  MessageSquareText,
  ShieldAlert,
  UserRound,
  UsersRound,
  Workflow,
} from 'lucide-react';

interface Props {
  kind: 'automation' | 'employees';
  locale?: 'zh-CN' | 'en';
}

const { kind, locale = 'zh-CN' } = Astro.props;
const english = locale === 'en';

const automation = english ? {
  marker: 'AUTOMATION / CONTROL LOOP',
  title: 'One definition, repeatable local runs, inspectable outcomes.',
  body: 'Automation turns a bounded General Work task into a fresh session on a local schedule. The task definition remains editable; every execution remains traceable as its own run.',
  specification: 'TASK SPECIFICATION',
  specValue: 'Prompt · Model · Workspace · Skills · MCP',
  schedule: 'SCHEDULE',
  scheduleValue: 'Recurring · Interval · Once · Active window',
  stages: [
    { label: 'Define', value: 'Outcome and execution boundary' },
    { label: 'Schedule', value: 'Local time and run window' },
    { label: 'Run', value: 'A fresh General Work session' },
    { label: 'Inspect', value: 'Status, session, output, or error' },
  ],
  signalTitle: 'UNATTENDED EXECUTION',
  signal: 'Full access and bypass approval are intentionally visible because they allow background work to continue. System elevation and hard security blocks still apply.',
  footer: 'LOCAL SCHEDULER · ACTIVE WHILE THE WORDLESS DESKTOP PROCESS IS RUNNING',
} : {
  marker: '自动化 / 运行闭环',
  title: '一次定义，按本地计划重复执行，结果始终可追踪。',
  body: 'Automation 会把边界明确的 General Work 任务变为按本地时钟创建的新会话。任务定义可以继续编辑，每一次执行都保留为独立的运行记录。',
  specification: '任务定义',
  specValue: '提示词 · 模型 · 工作区 · Skills · MCP',
  schedule: '执行计划',
  scheduleValue: '周期 · 间隔 · 单次 · 生效时间窗',
  stages: [
    { label: '定义', value: '目标与执行边界' },
    { label: '计划', value: '本地时间与生效范围' },
    { label: '执行', value: '一个新的 General Work 会话' },
    { label: '检查', value: '状态、会话、结果或错误' },
  ],
  signalTitle: '无人值守执行',
  signal: '完全访问和绕过工具审批会让任务在后台持续执行，因此被刻意显著标出。系统提权和硬性安全拦截仍然生效。',
  footer: '本地调度器 · 仅在 WORDLESS 桌面进程运行期间保持活跃',
};

const employees = english ? {
  marker: 'DIGITAL EMPLOYEES / ROLE SYSTEM',
  title: 'Stable roles for one focused session or a coordinated team.',
  body: 'A digital employee gives a session an explicit identity, instructions, and selected capabilities. A team adds a lead who owns the final response and named members for separable work.',
  employee: 'INDIVIDUAL EMPLOYEE',
  employeeValue: 'Identity · Instructions · Skills · MCP',
  team: 'TEAM SESSION',
  teamValue: 'Lead coordinates · Members execute bounded tasks',
  stages: [
    { label: 'Configure', value: 'Role, responsibility, and allowed capabilities' },
    { label: 'Summon', value: 'Create a new session from a role snapshot' },
    { label: 'Delegate', value: 'Single, parallel, or sequential specialist work' },
    { label: 'Synthesize', value: 'The lead reviews results and delivers the answer' },
  ],
  signalTitle: 'CLEAR ACCOUNTABILITY',
  signal: 'Team members cannot delegate again. The lead decides whether delegation is worthwhile, reads every result, resolves conflicts, and remains accountable for the final response.',
  footer: 'SESSION-SCOPED ROLE SNAPSHOT · EDITS APPLY TO FUTURE SESSIONS',
} : {
  marker: '数字员工 / 角色系统',
  title: '用稳定的身份完成单一会话，或让团队协同完成复杂任务。',
  body: '数字员工为会话提供明确身份、指令和已选能力。团队则增加一位对最终回答负责的负责人，以及处理可拆分任务的具名成员。',
  employee: '单个员工',
  employeeValue: '身份 · 指令 · Skills · MCP',
  team: '团队会话',
  teamValue: '负责人协调 · 成员执行边界明确的任务',
  stages: [
    { label: '配置', value: '角色、职责与允许的能力' },
    { label: '召唤', value: '基于角色快照创建一个新会话' },
    { label: '委派', value: '单项、并行或串行的专长任务' },
    { label: '汇总', value: '负责人检查结果并交付最终回答' },
  ],
  signalTitle: '责任清晰',
  signal: '团队成员不能再次委派任务。负责人决定何时值得委派，阅读每一项结果、解决冲突，并对最终回答负责。',
  footer: '会话级角色快照 · 后续编辑只影响新的会话',
};

const copy = kind === 'automation' ? automation : employees;
const definition = kind === 'automation'
  ? [
      { icon: FilePenLine, label: automation.specification, value: automation.specValue },
      { icon: CalendarClock, label: automation.schedule, value: automation.scheduleValue },
    ]
  : [
      { icon: UserRound, label: employees.employee, value: employees.employeeValue },
      { icon: UsersRound, label: employees.team, value: employees.teamValue },
    ];
const stageIcons = kind === 'automation'
  ? [FilePenLine, CalendarClock, Clock3, CircleCheck]
  : [UserRound, MessageSquareText, GitBranch, Workflow];
---

<section class={`operational-blueprint operational-blueprint--${kind}`} aria-label={copy.marker}>
  <header class="operational-blueprint__heading">
    <p>{copy.marker}</p>
    <div>
      <h2>{copy.title}</h2>
      <span>{copy.body}</span>
    </div>
  </header>

  <div class="operational-blueprint__board">
    <div class="operational-blueprint__definition">
      {definition.map(({ icon: Icon, label, value }) => <div><Icon aria-hidden="true" size={18} strokeWidth={1.65} /><span><small>{label}</small><strong>{value}</strong></span></div>)}
    </div>

    <ol class="operational-blueprint__flow">
      {copy.stages.map((stage, index) => {
        const Icon = stageIcons[index]!;
        return <li>
          <span class="operational-blueprint__step">{String(index + 1).padStart(2, '0')}</span>
          <span class="operational-blueprint__icon"><Icon aria-hidden="true" size={17} strokeWidth={1.65} /></span>
          <span><strong>{stage.label}</strong><small>{stage.value}</small></span>
        </li>;
      })}
    </ol>

    <aside class="operational-blueprint__signal">
      <ShieldAlert aria-hidden="true" size={18} strokeWidth={1.65} />
      <div><strong>{copy.signalTitle}</strong><p>{copy.signal}</p></div>
    </aside>
    <p class="operational-blueprint__footer">{copy.footer}</p>
  </div>
</section>
